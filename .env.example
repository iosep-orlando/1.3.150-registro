# Copiá este fichero a .env.local y completalo. .env.local no se sube al repo.

# MongoDB. Si tu Mongo pide usuario (como el de otros proyectos), usá su
# cadena completa: esta app usa su propia base ("registro").
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=registro

# Quiénes son funcionarios: emails separados por comas. Todos los demás que
# entren son ciudadanos (administrados). El seed crea el primero de la lista.
FUNCIONARIO_EMAILS=funcionario@registro.test

# Correo en desarrollo: MailHog (o Mailpit). Los mails se ven en
# http://localhost:8025
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# RustFS (S3) para los adjuntos, los justificantes y el escudo. AWS_URL es
# la API S3 (no la consola). El bucket se crea solo si no existe.
AWS_USERNAME=rustfsadmin
AWS_PASSWORD=rustfsadmin
AWS_REGION=us-east-1
AWS_URL=http://localhost:9001
# AWS_BUCKET=registro

# Firma de las sesiones. En desarrollo es opcional (hay una fija); en
# producción es obligatoria: openssl rand -base64 32
# JWT_SECRET=
